# Copy to .env.local and replace all example values.
DATABASE_URL="file:./dev.db"

# Required: use a cryptographically random value with at least 32 characters.
# Example generation: openssl rand -base64 48
JWT_SECRET="replace-with-a-random-secret-of-at-least-32-characters"

# Required only for legacy admin reset tooling; never expose with NEXT_PUBLIC_ prefix.
ADMIN_RESET_KEY="replace-with-a-separate-random-admin-key"

# Demo account creation is disabled unless explicitly enabled in a non-production environment.
DEMO_SETUP_ENABLED="false"
