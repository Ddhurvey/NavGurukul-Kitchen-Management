# Copy to .env.local and replace all example values.
DATABASE_URL="file:./dev.db"

# Required: use a cryptographically random value with at least 32 characters.
# Example generation: openssl rand -base64 48
JWT_SECRET="replace-with-a-random-secret-of-at-least-32-characters"

# Required only for legacy admin reset tooling; never expose with NEXT_PUBLIC_ prefix.
ADMIN_RESET_KEY="replace-with-a-separate-random-admin-key"

# Demo account creation is disabled unless explicitly enabled in a non-production environment.
DEMO_SETUP_ENABLED="false"

# Required to authenticate scheduled notification/cron requests.
# Generate a separate random value; set the same value in the scheduler and Vercel.
CRON_SECRET="replace-with-a-separate-random-cron-secret"

# Optional: Discord webhook for notification routes. Rotate any webhook previously committed to Git history.
DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/replace-with-your-new-webhook"
