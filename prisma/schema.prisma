// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Student {
  id              String    @id @default(cuid())
  name            String
  email           String    @unique
  password        String    // Added for authentication
  discordId       String?
  foodPreference  FoodType  @default(PANEER) // PANEER or EGG
  workType        WorkType  @default(KITCHEN) // KITCHEN, TEAM, NONE
  status          Status    @default(ACTIVE) // ACTIVE, LEAVE, PLACED, INACTIVE
  joinedAt        DateTime  @default(now())
  leaveStartAt    DateTime?
  leaveEndAt      DateTime?
  fcStartAt       DateTime?
  fcEndAt         DateTime?
  totalDuties     Int       @default(0)
  lastDutyDate    DateTime?
  nextAvailableDate DateTime?
  lastLoginAt     DateTime?
  isActive        Boolean   @default(true) // For login/logout status
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  assignedDuties  KitchenDuty[] @relation("TeamLeader")
  assignedDuties2 KitchenDuty[] @relation("Member2")
  assignedDuties3 KitchenDuty[] @relation("Member3")
  assignedDuties4 KitchenDuty[] @relation("Member4")
  
  // History relations
  historyDutiesAsLeader KitchenHistory[] @relation("HistoryTeamLeader")
  historyDutiesAsMember2 KitchenHistory[] @relation("HistoryMember2")
  historyDutiesAsMember3 KitchenHistory[] @relation("HistoryMember3")
  historyDutiesAsMember4 KitchenHistory[] @relation("HistoryMember4")
  
  dutySwapsRequested DutySwap[] @relation("SwapRequester")
  dutySwapsTargeted   DutySwap[] @relation("SwapTarget")
  leaveRecords    LeaveRecord[]
  statusHistory   StudentStatusChange[]
  sessions        StudentSession[]

  @@map("students")
}

model KitchenDuty {
  id          String    @id @default(cuid())
  date        DateTime  @unique
  teamLeaderId String
  member2Id   String
  member3Id   String
  member4Id   String
  breakfast   String?
  lunch       String?
  snacks      String?
  dinner      String?
  isCompleted Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  teamLeader  Student   @relation("TeamLeader", fields: [teamLeaderId], references: [id])
  member2     Student   @relation("Member2", fields: [member2Id], references: [id])
  member3     Student   @relation("Member3", fields: [member3Id], references: [id])
  member4     Student   @relation("Member4", fields: [member4Id], references: [id])
  
  // Link to history record
  historyRecord KitchenHistory?

  @@map("kitchen_duties")
}

model DutySwap {
  id          String     @id @default(cuid())
  requesterId String
  targetId    String
  dutyDate    DateTime
  reason      String
  status      SwapStatus @default(PENDING) // PENDING, APPROVED, REJECTED
  requesterApproved Boolean @default(false)
  targetApproved     Boolean @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // Relations
  requester   Student   @relation("SwapRequester", fields: [requesterId], references: [id])
  target      Student   @relation("SwapTarget", fields: [targetId], references: [id])

  @@map("duty_swaps")
}

model LeaveRecord {
  id          String    @id @default(cuid())
  studentId   String
  startDate   DateTime
  endDate     DateTime
  reason      String
  status      LeaveStatus @default(APPROVED) // APPROVED, REJECTED
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  student     Student   @relation(fields: [studentId], references: [id])

  @@map("leave_records")
}

model KitchenHistory {
  id          String    @id @default(cuid())
  date        DateTime  @unique
  teamName    String?   // Name of the kitchen team for that day
  teamLeaderId String?
  member2Id   String?
  member3Id   String?
  member4Id   String?
  teamLeaderName String?
  member2Name String?
  member3Name String?
  member4Name String?
  breakfast   String?
  lunch       String?
  snacks      String?
  dinner      String?
  foodPreference String?  // PANEER or EGG
  isCompleted Boolean   @default(false)
  notes       String?   // Any additional notes about the day
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations to students for direct access
  teamLeader  Student?  @relation("HistoryTeamLeader", fields: [teamLeaderId], references: [id])
  member2     Student?  @relation("HistoryMember2", fields: [member2Id], references: [id])
  member3     Student?  @relation("HistoryMember3", fields: [member3Id], references: [id])
  member4     Student?  @relation("HistoryMember4", fields: [member4Id], references: [id])

  // Link to actual duty assignment
  dutyAssignment KitchenDuty? @relation(fields: [date], references: [date])

  @@map("kitchen_history")
}

model MenuOverride {
  id          String    @id @default(cuid())
  date        DateTime  @unique
  breakfast   String?
  lunch       String?
  snacks      String?
  dinner      String?
  reason      String?
  createdBy   String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("menu_overrides")
}

model StudentSession {
  id        String   @id @default(cuid())
  studentId String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  // Relations
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("student_sessions")
}

model StudentStatusChange {
  id          String    @id @default(cuid())
  studentId   String
  oldStatus   Status
  newStatus   Status
  reason      String
  changedBy   String   // ID of the user who made the change
  createdAt   DateTime  @default(now())

  // Relations
  student     Student   @relation(fields: [studentId], references: [id])

  @@map("student_status_changes")
}

enum FoodType {
  PANEER
  EGG
}

enum WorkType {
  KITCHEN
  TEAM
  NONE
}

enum Status {
  ACTIVE
  LEAVE
  PLACED
  INACTIVE
}

enum SwapStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LeaveStatus {
  APPROVED
  REJECTED
}