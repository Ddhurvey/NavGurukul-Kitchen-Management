// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Student {
  id              String   @id @default(cuid())
  name            String
  email           String   @unique
  password        String?  // Optional password for existing users
  foodPreference  String   // "egg" or "paneer"
  workAssignment  String?  // "Kitchen", "Team", "None", etc.
  isActive        Boolean  @default(true)
  isPresent       Boolean  @default(true)
  isTeamMember    Boolean  @default(false)
  isJobPlaced     Boolean  @default(false)
  profileClosed   Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  dutyAssignments DutyAssignment[]
  leaves          Leave[]
  swapRequests    SwapRequest[] @relation("StudentSwaps")
  swapApprovals   SwapRequest[] @relation("StudentApprovals")
  fcAssignments   FoodCoordinator[]
  tlAssignments   KitchenDuty[] @relation("TeamLead")

  @@map("students")
}

model FoodCoordinator {
  id          String   @id @default(cuid())
  studentId   String
  startDate   DateTime
  endDate     DateTime
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  student     Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  menus       FoodMenu[]

  @@map("food_coordinators")
}

model KitchenDuty {
  id          String   @id @default(cuid())
  date        DateTime @unique
  teamLeadId  String?
  cycleNumber Int      @default(1)
  dayInCycle  Int      @default(1) // Day number in the current cycle (1-7)
  isSundaySpecial Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  teamLead    Student? @relation("TeamLead", fields: [teamLeadId], references: [id])
  assignments DutyAssignment[]

  @@map("kitchen_duties")
}

model DutyAssignment {
  id            String   @id @default(cuid())
  kitchenDutyId String
  studentId     String
  isTeamLead    Boolean  @default(false)
  createdAt     DateTime @default(now())

  kitchenDuty   KitchenDuty @relation(fields: [kitchenDutyId], references: [id], onDelete: Cascade)
  student       Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([kitchenDutyId, studentId])
  @@map("duty_assignments")
}

model Leave {
  id          String   @id @default(cuid())
  studentId   String
  startDate   DateTime
  endDate     DateTime
  reason      String
  status      String   @default("pending") // "pending", "approved", "rejected"
  requestedAt DateTime @default(now())
  reviewedAt  DateTime?
  reviewedBy  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  student     Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("leaves")
}

model SwapRequest {
  id              String   @id @default(cuid())
  requesterId     String
  approverId      String
  originalDate    DateTime
  swapDate        DateTime
  reason          String
  status          String   @default("pending") // "pending", "approved", "rejected"
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  requester       Student @relation("StudentSwaps", fields: [requesterId], references: [id], onDelete: Cascade)
  approver        Student @relation("StudentApprovals", fields: [approverId], references: [id], onDelete: Cascade)

  @@map("swap_requests")
}

model FoodMenu {
  id          String   @id @default(cuid())
  date        DateTime @unique
  breakfast   String?
  lunch       String?
  snacks      String?
  dinner      String?
  fcId        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  fc          FoodCoordinator @relation(fields: [fcId], references: [id], onDelete: Cascade)

  @@map("food_menus")
}

model Notification {
  id            String   @id @default(cuid())
  type          String
  message       String
  targetDate    DateTime
  sentAt        DateTime @default(now())
  recipientIds  String   // JSON array of student IDs
  status        String   @default("sent") // "sent", "failed", "pending"

  @@map("notifications")
}

model KitchenHistory {
  id            String   @id @default(cuid())
  date          DateTime @unique
  teamLeadId    String?
  teamMembers   String   // JSON array of student IDs
  foodPreferences String // JSON array of food preferences
  isSundaySpecial Boolean @default(false)
  cycleNumber   Int
  dayInCycle    Int
  status        String   @default("assigned") // "assigned", "modified", "cancelled"
  assignedAt    DateTime @default(now())
  modifiedAt    DateTime?
  modifiedBy    String?
  notes         String?

  @@map("kitchen_history")
}

model NotificationSchedule {
  id            String   @id @default(cuid())
  type          String   // "daily_assignment", "reminder", "custom"
  scheduledTime DateTime
  message       String
  targetDate    DateTime
  status        String   @default("pending") // "pending", "sent", "failed", "cancelled"
  sentAt        DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("notification_schedules")
}

model DutyRotation {
  id                String   @id @default(cuid())
  currentCycle      Int      @default(1)
  currentDayInCycle Int      @default(1) // 1-7, where 7 is Sunday
  lastAssignedIndex Int      @default(0) // Index of last student assigned in rotation
  studentQueue      String   // JSON array of student IDs in rotation order
  isActive          Boolean  @default(true)
  updatedAt         DateTime @updatedAt

  @@map("duty_rotation")
}